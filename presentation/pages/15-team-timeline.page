animations:
  # G1（auto）: 标题栏 + 时间轴 fade-in
  - elementId: eyebrow
    effect: fade-in
    trigger: withPrevious
  - elementId: title
    effect: fade-in
    trigger: withPrevious
  - elementId: subtitle
    effect: fade-in
    trigger: withPrevious
  - elementId: axis
    effect: fade-in
    trigger: withPrevious
  # G2（click）: 节点 1–2 wipe-in(up) 同时
  - elementId: n1-dot
    effect: wipe-in
    direction: up
    trigger: onClick
  - elementId: n1-text
    effect: wipe-in
    direction: up
    trigger: withPrevious
  - elementId: n2-dot
    effect: wipe-in
    direction: up
    trigger: withPrevious
  - elementId: n2-text
    effect: wipe-in
    direction: up
    trigger: withPrevious
  # G3（click）: 节点 3–4 wipe-in(up) 同时
  - elementId: n3-dot
    effect: wipe-in
    direction: up
    trigger: onClick
  - elementId: n3-text
    effect: wipe-in
    direction: up
    trigger: withPrevious
  - elementId: n4-dot
    effect: wipe-in
    direction: up
    trigger: withPrevious
  - elementId: n4-text
    effect: wipe-in
    direction: up
    trigger: withPrevious
