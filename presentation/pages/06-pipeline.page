  - elementId: flow-track
    effect: fade-in
    trigger: withPrevious
  # G2（click）: 阶段 1 + 审计链横条
  - elementId: card-1
    effect: wipe-in
    direction: right
    trigger: onClick
  - elementId: flow-link
    effect: fade-in
    trigger: withPrevious
  - elementId: audit-panel
    effect: fade-in
    trigger: withPrevious
  - elementId: audit-table
    effect: fade-in
    trigger: withPrevious
  # G3（click）: 阶段 2→5 依次
  - elementId: card-2
    effect: wipe-in
    direction: right
    trigger: onClick
  - elementId: card-3
    effect: wipe-in
    direction: right
    trigger: afterPrevious
  - elementId: card-4
    effect: wipe-in
    direction: right
    trigger: afterPrevious
  - elementId: card-5
    effect: wipe-in
    direction: right
    trigger: afterPrevious
