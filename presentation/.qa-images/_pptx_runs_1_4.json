 "3": [
  {
   "text": "03 · PAINPOINTS",
   "color": "22D3EE",
   "sz": 9.0,
   "bold": true
  },
  {
   "text": "GOAI · TERMINAL — ",
   "color": "8B949E",
   "sz": 8.0,
   "bold": false
  },
  {
   "text": "初赛评审   ",
