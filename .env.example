# GOAI LLM 辩论运行时配置示例（复制为 .env 使用；.env 已 gitignore，密钥不入库）
# DeepSeek 使用 OpenAI 兼容接口；也可替换为其他兼容服务商的 base_url。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GOAI_CHAT_MODEL=deepseek-chat
GOAI_REASONER_MODEL=deepseek-reasoner

# 可选：超时与重试
GOAI_CHAT_TIMEOUT_S=30
GOAI_REASONER_TIMEOUT_S=90
GOAI_LLM_RETRIES=2
GOAI_LLM_RETRY_BACKOFF_S=0.5

# 可选历史价格与 30 日实现波动率
GOAI_OPENBB_ENABLED=1
GOAI_OPENBB_PROVIDER=yfinance
GOAI_OPENBB_PERIOD=2y

# 可切换的 canonical 投研资料源
GOAI_RESEARCH_ITEMS_PATH=data/research_items_hero.json

# 实时行情（第二阶段 SSE 推送；第一阶段变量 GOAI_DATA_MODE=live|replay）
GOAI_DATA_MODE=replay
# 上游 feed：poll=2s diff 轮询（缺省）| push=真实 OpenD 订阅推送（失败/静默自动回退轮询）
GOAI_LIVE_FEED=poll
# GOAI_LIVE_STREAM_POLL_SECONDS=2.0
# GOAI_LIVE_STREAM_PUSH_SILENCE_SECONDS=60.0
# GOAI_LIVE_STREAM_MAX_SUBSCRIBERS=8

# P0c 模拟提交（可选；未配置时 POST /api/submit 返回 503 ACCOUNT_UNAVAILABLE）
# 交易环境恒为 Futu SIMULATE 模拟盘；交易解锁在 OpenD GUI 手动完成（SDK 无解锁能力）
# GOAI_TRADE_ACCOUNT_ID=12345678
# GOAI_TRADE_CURRENCY=HKD
# GOAI_TRADE_SECURITY_FIRM=FUTUSECURITIES
