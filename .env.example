# GOAI LLM 辩论运行时配置示例（复制为 .env 使用；.env 已 gitignore，密钥不入库）
# DeepSeek 使用 OpenAI 兼容接口；也可替换为其他兼容服务商的 base_url。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GOAI_CHAT_MODEL=deepseek-chat
GOAI_REASONER_MODEL=deepseek-reasoner

# 可选：超时与重试
GOAI_CHAT_TIMEOUT_S=30
GOAI_REASONER_TIMEOUT_S=90
GOAI_LLM_RETRIES=2
GOAI_LLM_RETRY_BACKOFF_S=0.5
