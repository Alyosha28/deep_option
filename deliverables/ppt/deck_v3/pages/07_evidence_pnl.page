pageType: content
notes: |
  证据页一 v4：左表右图数据新闻版式——左侧到期情景损益规则表（涨跌着色），右侧 IV crush 双系列柱状图；底部口径注记 + 一行结论，取消强制金句。
background:
  type: solid
  color: "$paper"
elements:
  - elementId: kicker
    elementType: text
    bounds: [48, 28, 500, 14]
    content:
      style: "$kicker"
      text: EVIDENCE · 06
  - elementId: folio
    elementType: text
    bounds: [812, 28, 100, 14]
    content:
      style: "$folio"
      align: [right, top]
      text: 07 / 16
  - elementId: title
    elementType: text
    bounds: [48, 48, 864, 38]
    content:
      style: "$display"
      text: 期望收益不成立：预期波动低于成本，IV crush 后更差
  - elementId: standfirst
    elementType: text
    bounds: [48, 90, 864, 18]
    content:
      style: "$standfirst"
      text: 到期情景损益（HKD，ask 成本口径）与 IV crush 压力测试
  - elementId: rule-thick
    elementType: shape
    bounds: [48, 118, 864, 3]
    shapeName: rect
    fill: {type: solid, color: "$ink"}
  - elementId: rule-thin
    elementType: shape
    bounds: [48, 124.5, 864, 0.75]
    shapeName: rect
    fill: {type: solid, color: "$ink"}
  - elementId: pnl-table
    elementType: table
    bounds: [48, 146, 420, 254]
    style: "$default"
    columnWidths: [0.38, 0.31, 0.31]
    rowHeights: [0.13, 0.29, 0.29, 0.29]
    rows:
      - - text: 到期情景
        - text: 上行 P&L
        - text: 下行 P&L
      - - text: ±1× 预期波动
        - text: "-904"
          color: "$down"
        - text: "-424"
          color: "$down"
      - - text: ±1.5× 预期波动
        - text: "+971"
          color: "$up"
        - text: "+1,451"
          color: "$up"
      - - text: ±2× 预期波动
        - text: "+2,846"
          color: "$up"
        - text: "+3,326"
          color: "$up"
  - elementId: pnl-note
    elementType: text
    bounds: [48, 408, 420, 16]
    content:
      style: "$cap"
      color: "$sub"
      text: 两腿按到期内在价值估算，未计入业绩后剩余时间价值
  - elementId: crush-chart
    elementType: chart
    bounds: [504, 146, 408, 276]
    data:
      cols: [crush, up, down]
      rows:
        - ["-20%", -711, -340]
        - ["-35%", -820, -403]
        - ["-50%", -873, -422]
    title:
      text: IV crush 后 P&L（HKD，方向正确情形）
      fontSize: 12
      color: "$ink"
    legend: {show: true, position: top, fontSize: 9, color: "$sub"}
    fontFamily: {latin: Arial, ea: Microsoft YaHei}
    xAxis: {label: {fontSize: 9, color: "$sub"}, axisLine: {color: "#161A2033"}, gridLine: {show: false}}
    yAxis: {label: {numberFormat: "0", fontSize: 9, color: "$sub"}, axisLine: {color: "#161A2033"}, gridLine: {color: "#161A2014", width: 1}}
    series:
      - type: bar
        encode: {x: crush, y: up}
        name: 上行
        fill: "$down"
        dataLabels: {show: true, numberFormat: "0", fontSize: 9, color: "$sub"}
      - type: bar
        encode: {x: crush, y: down}
        name: 下行
        fill: "$warn"
        dataLabels: {show: true, numberFormat: "0", fontSize: 9, color: "$sub"}
  - elementId: conclusion
    elementType: text
    bounds: [48, 470, 864, 18]
    content:
      style: "$small"
      color: "$sub"
      text: IV crush -20% 时，即使方向正确也亏损 -711 HKD——预期波动不足以覆盖买入成本。
  - elementId: footer-rule
    elementType: line
    bounds: [48, 506, 864, 1]
    viewBox: [864, 1]
    points: "0,0 864,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: footer-left
    elementType: text
    bounds: [48, 512, 700, 14]
    content:
      style: "$source"
      text: 数据：decision_card_2026-08-12.json（proposal_ref）
  - elementId: footer-right
    elementType: text
    bounds: [612, 512, 300, 14]
    content:
      style: "$source"
      align: [right, top]
      text: GOAI 港美股期权智能终端
animations:
  - elementId: kicker
    effect: fade-in
    trigger: afterPrevious
    durationMs: 300
  - elementId: folio
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: title
    effect: rise-in
    trigger: afterPrevious
    durationMs: 450
    easing: ease-out
    delayMs: 60
  - elementId: standfirst
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: rule-thick
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 350
  - elementId: rule-thin
    effect: wipe-in
    trigger: withPrevious
    direction: right
    durationMs: 350
  - elementId: pnl-table
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
    delayMs: 60
  - elementId: pnl-note
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: crush-chart
    effect: zoom-in
    trigger: afterPrevious
    durationMs: 450
    easing: ease-out
    delayMs: 100
  - elementId: conclusion
    effect: fade-in
    trigger: afterPrevious
    durationMs: 300
  - elementId: footer-rule
    effect: fade-in
    trigger: withPrevious
    durationMs: 200
  - elementId: footer-left
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: footer-right
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
