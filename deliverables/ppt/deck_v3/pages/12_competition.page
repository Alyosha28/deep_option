pageType: content
notes: |
  竞品页 v4：全宽规则表（6 方案 × 5 维度，GOAI 行墨底反白），表下一行五维度口径注释，底部一行结论；表内评价为依据公开研究的定性判断。
background:
  type: solid
  color: "$paper"
elements:
  - elementId: kicker
    elementType: text
    bounds: [48, 28, 500, 14]
    content:
      style: "$kicker"
      text: COMPETITION · 11
  - elementId: folio
    elementType: text
    bounds: [812, 28, 100, 14]
    content:
      style: "$folio"
      align: [right, top]
      text: 12 / 16
  - elementId: title
    elementType: text
    bounds: [48, 48, 864, 38]
    content:
      style: "$display"
      text: 差异不在算法，而在可信闭环：可复算、可审计、敢拒绝
  - elementId: standfirst
    elementType: text
    bounds: [48, 90, 864, 18]
    content:
      style: "$standfirst"
      text: 对比维度：数据、数值可信、账户约束、审计溯源、允许 NO_TRADE
  - elementId: rule-thick
    elementType: shape
    bounds: [48, 118, 864, 3]
    shapeName: rect
    fill: {type: solid, color: "$ink"}
  - elementId: rule-thin
    elementType: shape
    bounds: [48, 124.5, 864, 0.75]
    shapeName: rect
    fill: {type: solid, color: "$ink"}
  - elementId: diff-table
    elementType: table
    bounds: [48, 142, 864, 270]
    style: "$default"
    columnWidths: [0.28, 0.15, 0.15, 0.15, 0.14, 0.13]
    rowHeights: [0.1, 0.15, 0.15, 0.15, 0.15, 0.15, 0.15]
    rows:
      - - text: 方案
        - text: 数据
        - text: 数值可信
        - text: 账户约束
        - text: 审计
        - text: NO_TRADE
      - - text: Futu 手工流程
        - text: 强
        - text: 中
        - text: 中
        - text: 无
        - text: 无
      - - text: 通用 LLM
        - text: 弱
        - text: 弱
        - text: 无
        - text: 无
        - text: 无
      - - text: 固定脚本
        - text: 中
        - text: 强
        - text: 弱
        - text: 无
        - text: 无
      - - text: Moomoo Engine
        - text: 强
        - text: 中
        - text: 中
        - text: 无
        - text: 无
      - - text: Moontower
        - text: 中
        - text: 中
        - text: 无
        - text: 无
        - text: 无
      - - text: GOAI（本方案）
          bold: true
          color: "$paper"
          fill: {type: solid, color: "$ink"}
        - text: 强
          bold: true
          color: "$paper"
          fill: {type: solid, color: "$ink"}
        - text: 强
          bold: true
          color: "$paper"
          fill: {type: solid, color: "$ink"}
        - text: 强
          bold: true
          color: "$paper"
          fill: {type: solid, color: "$ink"}
        - text: 强
          bold: true
          color: "$paper"
          fill: {type: solid, color: "$ink"}
        - text: 强
          bold: true
          color: "$paper"
          fill: {type: solid, color: "$ink"}
  - elementId: dim-note
    elementType: text
    bounds: [48, 426, 864, 14]
    content:
      style: "$cap"
      color: "$sub"
      text: |
        · 数据：是否真实、带时间 · 数值：能否复算 · 账户：是否算现金与保证金 · 审计：错了能否复盘 · NO_TRADE：敢不敢拒绝 —— 评审可逐项回到本方案前页证据。
  - elementId: conclusion
    elementType: text
    bounds: [48, 472, 864, 18]
    content:
      style: "$small"
      fontSize: 10.5
      color: "$sub"
      text: 护城河 = 对话场景 → 账户约束求解 + 流动性/事件预警 + 可复核审计；竞品信息来自公开研究（research/01-market-landscape.md）。
  - elementId: footer-rule
    elementType: line
    bounds: [48, 506, 864, 1]
    viewBox: [864, 1]
    points: "0,0 864,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: footer-left
    elementType: text
    bounds: [48, 512, 700, 14]
    content:
      style: "$source"
      text: 来源：research/01-market-landscape.md（方向性判断，2026-08 公开资料）
  - elementId: footer-right
    elementType: text
    bounds: [612, 512, 300, 14]
    content:
      style: "$source"
      align: [right, top]
      text: GOAI 港美股期权智能终端
animations:
  - elementId: kicker
    effect: fade-in
    trigger: afterPrevious
    durationMs: 300
  - elementId: folio
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: title
    effect: rise-in
    trigger: afterPrevious
    durationMs: 450
    easing: ease-out
    delayMs: 60
  - elementId: standfirst
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: rule-thick
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 350
  - elementId: rule-thin
    effect: wipe-in
    trigger: withPrevious
    direction: right
    durationMs: 350
  - elementId: diff-table
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
    delayMs: 60
  - elementId: dim-note
    effect: fade-in
    trigger: afterPrevious
    durationMs: 300
    delayMs: 60
  - elementId: conclusion
    effect: fade-in
    trigger: afterPrevious
    durationMs: 300
  - elementId: footer-rule
    effect: fade-in
    trigger: withPrevious
    durationMs: 200
  - elementId: footer-left
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: footer-right
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
