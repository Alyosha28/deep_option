pageType: content
notes: |
  合规页 v4：报头双规则线 + 全宽双列规则表（5 条边界 × 对应铁律），底部 PASS 定义一行结论；按锁文件取消金句区。
background:
  type: solid
  color: "$paper"
elements:
  - elementId: kicker
    elementType: text
    bounds: [48, 28, 500, 14]
    content:
      style: "$kicker"
      text: COMPLIANCE · 14
  - elementId: folio
    elementType: text
    bounds: [812, 28, 100, 14]
    content:
      style: "$folio"
      align: [right, top]
      text: 15 / 16
  - elementId: title
    elementType: text
    bounds: [48, 48, 864, 38]
    content:
      style: "$display"
      text: 研究 / 教育 / 决策支持工具：不荐股、不代下单、不承诺收益
  - elementId: standfirst
    elementType: text
    bounds: [48, 90, 864, 18]
    content:
      style: "$standfirst"
      text: 合规边界与产品铁律一一对应（SFC Type 1/4/9 牌照边界内）
  - elementId: rule-thick
    elementType: shape
    bounds: [48, 118, 864, 3]
    shapeName: rect
    fill: {type: solid, color: "$ink"}
  - elementId: rule-thin
    elementType: shape
    bounds: [48, 124.5, 864, 0.75]
    shapeName: rect
    fill: {type: solid, color: "$ink"}
  - elementId: comp-table
    elementType: table
    bounds: [48, 142, 864, 316]
    style: "$default"
    columnWidths: [0.3, 0.7]
    rowHeights: [0.1, 0.18, 0.18, 0.18, 0.18, 0.18]
    rows:
      - - text: 边界
        - text: 对应铁律
      - - text: 投资建议边界
        - text: 页面与材料声明非投资建议，无荐股表达、无收益承诺
      - - text: 实盘风险
        - text: 比赛版本无实盘入口，不注册真实交易权限
      - - text: 模拟误操作
        - text: 独立确认 + 提交前复核 + 幂等；禁止自动重提、补腿、追价
      - - text: 数据授权
        - text: 授权行情与原始快照不重新分发；公开材料脱敏
      - - text: LLM 幻觉
        - text: 数值引擎 + 审计链兜底；LLM 只做解析、编排与解释
  - elementId: conclusion
    elementType: text
    bounds: [48, 470, 864, 18]
    content:
      style: "$small"
      color: "$sub"
      text: PASS 的含义是「当前数据、规则与风险门通过」，不代表盈利、成交或投资建议。
  - elementId: footer-rule
    elementType: line
    bounds: [48, 506, 864, 1]
    viewBox: [864, 1]
    points: "0,0 864,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: footer-left
    elementType: text
    bounds: [48, 512, 700, 14]
    content:
      style: "$source"
      text: 来源：research/03-boundaries-risks.md · docs/PRD.md §2.3 非目标
  - elementId: footer-right
    elementType: text
    bounds: [612, 512, 300, 14]
    content:
      style: "$source"
      align: [right, top]
      text: GOAI 港美股期权智能终端
animations:
  - elementId: kicker
    effect: fade-in
    trigger: afterPrevious
    durationMs: 300
  - elementId: folio
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: title
    effect: rise-in
    trigger: afterPrevious
    durationMs: 450
    easing: ease-out
    delayMs: 60
  - elementId: standfirst
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: rule-thick
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 350
  - elementId: rule-thin
    effect: wipe-in
    trigger: withPrevious
    direction: right
    durationMs: 350
  - elementId: comp-table
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
    delayMs: 60
  - elementId: conclusion
    effect: fade-in
    trigger: afterPrevious
    durationMs: 300
  - elementId: footer-rule
    effect: fade-in
    trigger: withPrevious
    durationMs: 200
  - elementId: footer-left
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: footer-right
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
