pageType: content
notes: |
  可信与审计页：数据来源分层、可复算、哈希链与脱敏；对应赛道「数据来源与隐私保护」。
background:
  type: solid
  color: "$paper"
elements:
  - elementId: corner
    elementType: text
    bounds: [792, 12, 104, 58]
    content:
      style: "$cornerNum"
      align: [right, top]
      text: "11"
  - elementId: tick
    elementType: shape
    bounds: [64, 44, 22, 2]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: kicker
    elementType: text
    bounds: [96, 36, 600, 16]
    content:
      style: "$eyebrow"
      text: TRUST & AUDIT · 10
  - elementId: title
    elementType: text
    bounds: [64, 56, 832, 40]
    content:
      style: "$display"
      fontSize: 26
      text: 数据分层可信，结论哈希可复核
  - elementId: standfirst
    elementType: text
    bounds: [64, 100, 832, 18]
    content:
      style: "$standfirst"
      text: 对应赛道评审口径：数据来源 · 隐私保护 · 审计与可复算
  - elementId: header-rule
    elementType: line
    bounds: [64, 124, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: source-table
    elementType: table
    bounds: [64, 140, 560, 268]
    style: "$default"
    columnWidths: [0.32, 0.34, 0.34]
    rowHeights: [0.1, 0.18, 0.18, 0.18, 0.18, 0.18]
    rows:
      - - text: 数字类型
        - text: 产出者
        - text: 证据
      - - text: 行情 / 盘口 / IV / OI
        - text: Futu OpenAPI / 冻结快照
        - text: 快照 SHA-256 + 时间
      - - text: 理论价值 / IV / Greeks
        - text: 自研 BS + 二叉树 + bump-and-reprice
        - text: 引擎版本 + 输入参数
      - - text: 可成交成本
        - text: 引擎（bid/ask + 费用 + 滑点 + tick）
        - text: 成本口径注明
      - - text: 门控判定
        - text: 确定性 Edge / Risk / Action
        - text: 决策卡 + 审计记录
      - - text: 自然语言理解 / 解释
        - text: LLM
        - text: 不进入金融数字
  - elementId: chain-label
    elementType: text
    bounds: [640, 140, 256, 16]
    content:
      style: "$small"
      bold: true
      color: "$sub"
      text: 审计哈希链（Hero 7 条记录）
  - elementId: chain-text
    elementType: text
    bounds: [640, 158, 256, 108]
    content:
      style: "$cap"
      text: |
        <p>scenario_parsed → data_loaded →</p>
        <p>engine_computed → edge_gate →</p>
        <p>risk_gate → action_gate →</p>
        <p>decision_card</p>
        <p><span style="color:$sub;">每条链接前一条，哈希仅展示前缀</span></p>
  - elementId: rule1-tick
    elementType: shape
    bounds: [640, 280, 14, 2]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: rule1
    elementType: text
    bounds: [664, 268, 232, 40]
    content:
      style: "$small"
      text: |
        <p>任何数字带来源、</p>
        <p>时间与口径</p>
  - elementId: rule2-tick
    elementType: shape
    bounds: [640, 334, 14, 2]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: rule2
    elementType: text
    bounds: [664, 322, 232, 40]
    content:
      style: "$small"
      text: |
        <p>LLM 估算的金融</p>
        <p>数字视为缺陷</p>
  - elementId: rule3-tick
    elementType: shape
    bounds: [640, 388, 14, 2]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: rule3
    elementType: text
    bounds: [664, 376, 232, 40]
    content:
      style: "$small"
      text: |
        <p>授权行情与原始快照</p>
        <p>不重新分发</p>
  - elementId: quote-rail
    elementType: shape
    bounds: [64, 434, 3, 46]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: quote-text
    elementType: text
    bounds: [80, 450, 800, 26]
    content:
      style: "$quote"
      text: '<p><span style="font-size:20px; color:$primary;">“</span>可复算，是金融数字的最低要求。</p>'
  - elementId: takeaway-rule
    elementType: line
    bounds: [64, 490, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: takeaway-text
    elementType: text
    bounds: [64, 493, 832, 24]
    content:
      style: "$small"
      fontSize: 10.5
      color: "$sub"
      text: 口径分离：理论价值 ≠ mid ≠ 买入成本 ≠ 平仓价值，四者并列展示、绝不混用；审计日志 JSONL + SHA-256 防误改。
  - elementId: footer-rule
    elementType: line
    bounds: [64, 524, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: footer-left
    elementType: text
    bounds: [64, 521, 650, 19]
    content:
      style: "$cap"
      text: 数据：research/audit/audit_log.jsonl · data/snapshots（本地保存，不重新分发）
  - elementId: footer-right
    elementType: text
    bounds: [704, 521, 192, 19]
    content:
      style: "$cap"
      align: [right, top]
      text: 11 / 16
animations:
  - elementId: corner
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
  - elementId: tick
    effect: wipe-in
    trigger: withPrevious
    direction: right
    durationMs: 250
  - elementId: kicker
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: title
    effect: rise-in
    trigger: afterPrevious
    durationMs: 450
    easing: ease-out
    delayMs: 80
  - elementId: standfirst
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: header-rule
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 350
  - elementId: source-table
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
    delayMs: 60
  - elementId: chain-label
    effect: fade-in
    trigger: afterPrevious
    durationMs: 250
    delayMs: 80
  - elementId: chain-text
    effect: fade-in
    trigger: withPrevious
    durationMs: 350
  - elementId: rule1-tick
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 250
    delayMs: 60
  - elementId: rule1
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: rule2-tick
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 250
    delayMs: 40
  - elementId: rule2
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: rule3-tick
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 250
    delayMs: 40
  - elementId: rule3
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: quote-rail
    effect: fade-in
    trigger: afterPrevious
    durationMs: 300
  - elementId: quote-text
    effect: fade-in
    trigger: withPrevious
    durationMs: 350
  - elementId: takeaway-rule
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 300
  - elementId: takeaway-text
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: footer-rule
    effect: fade-in
    trigger: afterPrevious
    durationMs: 200
  - elementId: footer-left
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: footer-right
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
