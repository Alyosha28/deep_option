pageType: content
notes: |
  问题页：五个断裂点让个人投资者无法完成一次可信的期权研究。
background:
  type: solid
  color: "$paper"
elements:
  - elementId: corner
    elementType: text
    bounds: [792, 12, 104, 58]
    content:
      style: "$cornerNum"
      align: [right, top]
      text: "03"
  - elementId: tick
    elementType: shape
    bounds: [64, 44, 22, 2]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: kicker
    elementType: text
    bounds: [96, 36, 600, 16]
    content:
      style: "$eyebrow"
      text: PROBLEM · 02
  - elementId: title
    elementType: text
    bounds: [64, 56, 832, 40]
    content:
      style: "$display"
      fontSize: 26
      text: 五个断裂点，让个人投资者做不了一次可信的期权研究
  - elementId: standfirst
    elementType: text
    bounds: [64, 100, 832, 18]
    content:
      style: "$standfirst"
      text: 对标现状：Futu 手工流程 · 通用 LLM · 固定脚本
  - elementId: header-rule
    elementType: line
    bounds: [64, 124, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: pain-table
    elementType: table
    bounds: [64, 140, 560, 268]
    style: "$default"
    columnWidths: [0.42, 0.58]
    rowHeights: [0.1, 0.18, 0.18, 0.18, 0.18, 0.18]
    rows:
      - - text: 断裂点
        - text: 后果
      - - text: 行情、规则、账户分散在多页面
        - text: 研究靠手工拼接，易漏规格与费用
      - - text: 理论价被当成成交价
        - text: 忽略 bid/ask、滑点与 tick，盈亏边界失真
      - - text: 港美股规则差异大
        - text: 美式/欧式、实物/现金交割混用模板
      - - text: 通用 LLM 会编造数字
        - text: 无法承担账户风控与交易权限判断
      - - text: 结论没有审计
        - text: 错后无法复盘，也无法向他人复核
  - elementId: result-label
    elementType: text
    bounds: [640, 144, 256, 14]
    content:
      style: "$cap"
      bold: true
      color: "$down"
      text: 结果
  - elementId: result-text
    elementType: text
    bounds: [640, 160, 256, 68]
    content:
      style: "$quote"
      fontSize: 18
      text: |
        <p>要么不敢决策，</p>
        <p>要么在错误口径上决策。</p>
  - elementId: result-rule
    elementType: line
    bounds: [640, 238, 256, 1]
    viewBox: [256, 1]
    points: "0,0 256,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: quote-plate
    elementType: shape
    bounds: [640, 252, 256, 96]
    shapeName: rect
    fill: {type: solid, color: "$primaryA"}
  - elementId: quote-rail
    elementType: shape
    bounds: [640, 252, 3, 96]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: quote-text
    elementType: text
    bounds: [656, 264, 224, 72]
    content:
      style: "$quote"
      fontSize: 12.5
      text: '<p><span style="font-size:20px; color:$primary;">“</span>不解决可信问题，再多工具也只是更快地犯错。</p>'
  - elementId: gap-note
    elementType: text
    bounds: [640, 362, 256, 44]
    content:
      style: "$cap"
      text: 研究缺口：一条让数字可信、结论可拒绝的完整期权研究闭环。
  - elementId: takeaway-rule
    elementType: line
    bounds: [64, 438, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: takeaway-text
    elementType: text
    bounds: [64, 441, 832, 24]
    content:
      style: "$small"
      fontSize: 10.5
      color: "$sub"
      text: 问题本质不是缺工具，而是缺一条「数字可信、结论可拒绝」的完整链路。
  - elementId: footer-rule
    elementType: line
    bounds: [64, 524, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: footer-left
    elementType: text
    bounds: [64, 521, 650, 19]
    content:
      style: "$cap"
      text: 来源：docs/PRD.md §1.2 当前痛点
  - elementId: footer-right
    elementType: text
    bounds: [704, 521, 192, 19]
    content:
      style: "$cap"
      align: [right, top]
      text: 03 / 16
animations:
  - elementId: corner
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
  - elementId: tick
    effect: wipe-in
    trigger: withPrevious
    direction: right
    durationMs: 250
  - elementId: kicker
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: title
    effect: rise-in
    trigger: afterPrevious
    durationMs: 450
    easing: ease-out
    delayMs: 80
  - elementId: standfirst
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: header-rule
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 350
  - elementId: pain-table
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
    delayMs: 60
  - elementId: result-label
    effect: fade-in
    trigger: afterPrevious
    durationMs: 250
    delayMs: 80
  - elementId: result-text
    effect: rise-in
    trigger: withPrevious
    durationMs: 350
    easing: ease-out
  - elementId: result-rule
    effect: wipe-in
    trigger: withPrevious
    direction: right
    durationMs: 250
  - elementId: quote-plate
    effect: fade-in
    trigger: afterPrevious
    durationMs: 350
    delayMs: 60
  - elementId: quote-rail
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: quote-text
    effect: fade-in
    trigger: withPrevious
    durationMs: 350
  - elementId: gap-note
    effect: fade-in
    trigger: afterPrevious
    durationMs: 300
  - elementId: takeaway-rule
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 300
  - elementId: takeaway-text
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: footer-rule
    effect: fade-in
    trigger: afterPrevious
    durationMs: 200
  - elementId: footer-left
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: footer-right
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
