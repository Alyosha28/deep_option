pageType: content
notes: |
  证据页一：买入跨式的期望收益不成立。左边到期情景损益，右边 IV crush 压力测试。
background:
  type: solid
  color: "$paper"
elements:
  - elementId: corner
    elementType: text
    bounds: [792, 12, 104, 58]
    content:
      style: "$cornerNum"
      align: [right, top]
      text: "07"
  - elementId: tick
    elementType: shape
    bounds: [64, 44, 22, 2]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: kicker
    elementType: text
    bounds: [96, 36, 600, 16]
    content:
      style: "$eyebrow"
      text: EVIDENCE · 06
  - elementId: title
    elementType: text
    bounds: [64, 56, 832, 40]
    content:
      style: "$display"
      fontSize: 26
      text: 期望收益不成立：预期波动低于成本，IV crush 后更差
  - elementId: standfirst
    elementType: text
    bounds: [64, 100, 832, 18]
    content:
      style: "$standfirst"
      text: 到期情景损益（HKD，ask 成本口径）与 IV crush 压力测试
  - elementId: header-rule
    elementType: line
    bounds: [64, 124, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: pnl-table
    elementType: table
    bounds: [64, 140, 420, 254]
    style: "$default"
    columnWidths: [0.38, 0.31, 0.31]
    rowHeights: [0.13, 0.29, 0.29, 0.29]
    rows:
      - - text: 到期情景
        - text: 上行 P&L
        - text: 下行 P&L
      - - text: ±1× 预期波动
        - text: "-904"
          color: "$down"
        - text: "-424"
          color: "$down"
      - - text: ±1.5× 预期波动
        - text: "+971"
          color: "$up"
        - text: "+1,451"
          color: "$up"
      - - text: ±2× 预期波动
        - text: "+2,846"
          color: "$up"
        - text: "+3,326"
          color: "$up"
  - elementId: pnl-note
    elementType: text
    bounds: [64, 400, 420, 16]
    content:
      style: "$cap"
      text: 两腿按到期内在价值估算，未计入业绩后剩余时间价值
  - elementId: crush-chart
    elementType: chart
    bounds: [520, 140, 376, 276]
    data:
      cols: [crush, up, down]
      rows:
        - ["-20%", -711, -340]
        - ["-35%", -820, -403]
        - ["-50%", -873, -422]
    title:
      text: IV crush 后 P&L（HKD，方向正确情形）
      fontSize: 12
      color: "$ink"
    legend: {show: true, position: top, fontSize: 9, color: "$sub"}
    fontFamily: {latin: Arial, ea: Microsoft YaHei}
    xAxis: {label: {fontSize: 9, color: "$sub"}, axisLine: {color: "#191B1F33"}, gridLine: {show: false}}
    yAxis: {label: {numberFormat: "0", fontSize: 9, color: "$sub"}, axisLine: {color: "#191B1F33"}, gridLine: {color: "#191B1F14", width: 1}}
    series:
      - type: bar
        encode: {x: crush, y: up}
        name: 上行
        fill: "$down"
        dataLabels: {show: true, numberFormat: "0", fontSize: 9, color: "$sub"}
      - type: bar
        encode: {x: crush, y: down}
        name: 下行
        fill: "$warn"
        dataLabels: {show: true, numberFormat: "0", fontSize: 9, color: "$sub"}
  - elementId: quote-rail
    elementType: shape
    bounds: [64, 434, 3, 46]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: quote-text
    elementType: text
    bounds: [80, 450, 800, 26]
    content:
      style: "$quote"
      text: '<p><span style="font-size:20px; color:$primary;">“</span>IV 涨上去的便宜，都会在 crush 里还回来。</p>'
  - elementId: takeaway-rule
    elementType: line
    bounds: [64, 490, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: takeaway-text
    elementType: text
    bounds: [64, 493, 832, 24]
    content:
      style: "$small"
      fontSize: 10.5
      color: "$sub"
      text: IV crush -20% 时，即使方向正确也亏损 -711 HKD——预期波动不足以覆盖买入成本。
  - elementId: footer-rule
    elementType: line
    bounds: [64, 524, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: footer-left
    elementType: text
    bounds: [64, 521, 650, 19]
    content:
      style: "$cap"
      text: 数据：decision_card_2026-08-12.json（proposal_ref）
  - elementId: footer-right
    elementType: text
    bounds: [704, 521, 192, 19]
    content:
      style: "$cap"
      align: [right, top]
      text: 07 / 16
animations:
  - elementId: corner
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
  - elementId: tick
    effect: wipe-in
    trigger: withPrevious
    direction: right
    durationMs: 250
  - elementId: kicker
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: title
    effect: rise-in
    trigger: afterPrevious
    durationMs: 450
    easing: ease-out
    delayMs: 80
  - elementId: standfirst
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: header-rule
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 350
  - elementId: pnl-table
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
    delayMs: 60
  - elementId: pnl-note
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: crush-chart
    effect: zoom-in
    trigger: afterPrevious
    durationMs: 450
    easing: ease-out
    delayMs: 100
  - elementId: quote-rail
    effect: fade-in
    trigger: afterPrevious
    durationMs: 300
  - elementId: quote-text
    effect: fade-in
    trigger: withPrevious
    durationMs: 350
  - elementId: takeaway-rule
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 300
  - elementId: takeaway-text
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: footer-rule
    effect: fade-in
    trigger: afterPrevious
    durationMs: 200
  - elementId: footer-left
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: footer-right
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
