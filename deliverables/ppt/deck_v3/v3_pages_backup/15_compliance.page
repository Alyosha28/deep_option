pageType: content
notes: |
  合规页：研究、教育、决策支持工具；不荐股、不代下单、不承诺收益。每条边界对应产品铁律。
background:
  type: solid
  color: "$paper"
elements:
  - elementId: corner
    elementType: text
    bounds: [792, 12, 104, 58]
    content:
      style: "$cornerNum"
      align: [right, top]
      text: "15"
  - elementId: tick
    elementType: shape
    bounds: [64, 44, 22, 2]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: kicker
    elementType: text
    bounds: [96, 36, 600, 16]
    content:
      style: "$eyebrow"
      text: COMPLIANCE · 14
  - elementId: title
    elementType: text
    bounds: [64, 56, 832, 40]
    content:
      style: "$display"
      fontSize: 26
      text: 研究 / 教育 / 决策支持工具：不荐股、不代下单、不承诺收益
  - elementId: standfirst
    elementType: text
    bounds: [64, 100, 832, 18]
    content:
      style: "$standfirst"
      text: 合规边界与产品铁律一一对应（SFC Type 1/4/9 牌照边界内）
  - elementId: header-rule
    elementType: line
    bounds: [64, 124, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: comp-table
    elementType: table
    bounds: [64, 140, 832, 280]
    style: "$default"
    columnWidths: [0.3, 0.7]
    rowHeights: [0.09, 0.182, 0.182, 0.182, 0.182, 0.182]
    rows:
      - - text: 边界
        - text: 对应铁律
      - - text: 投资建议边界
        - text: 页面与材料声明非投资建议，无荐股表达、无收益承诺
      - - text: 实盘风险
        - text: 比赛版本无实盘入口，不注册真实交易权限
      - - text: 模拟误操作
        - text: 独立确认 + 提交前复核 + 幂等；禁止自动重提、补腿、追价
      - - text: 数据授权
        - text: 授权行情与原始快照不重新分发；公开材料脱敏
      - - text: LLM 幻觉
        - text: 数值引擎 + 审计链兜底；LLM 只做解析、编排与解释
  - elementId: quote-rail
    elementType: shape
    bounds: [64, 434, 3, 46]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: quote-text
    elementType: text
    bounds: [80, 450, 800, 26]
    content:
      style: "$quote"
      text: '<p><span style="font-size:20px; color:$primary;">“</span>合规不是免责声明，是产品边界。</p>'
  - elementId: takeaway-rule
    elementType: line
    bounds: [64, 490, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: takeaway-text
    elementType: text
    bounds: [64, 493, 832, 24]
    content:
      style: "$small"
      fontSize: 10.5
      color: "$sub"
      text: PASS 的含义是「当前数据、规则与风险门通过」，不代表盈利、成交或投资建议。
  - elementId: footer-rule
    elementType: line
    bounds: [64, 524, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: footer-left
    elementType: text
    bounds: [64, 521, 650, 19]
    content:
      style: "$cap"
      text: 来源：research/03-boundaries-risks.md · docs/PRD.md §2.3 非目标
  - elementId: footer-right
    elementType: text
    bounds: [704, 521, 192, 19]
    content:
      style: "$cap"
      align: [right, top]
      text: 15 / 16
animations:
  - elementId: corner
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
  - elementId: tick
    effect: wipe-in
    trigger: withPrevious
    direction: right
    durationMs: 250
  - elementId: kicker
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: title
    effect: rise-in
    trigger: afterPrevious
    durationMs: 450
    easing: ease-out
    delayMs: 80
  - elementId: standfirst
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: header-rule
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 350
  - elementId: comp-table
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
    delayMs: 60
  - elementId: quote-rail
    effect: fade-in
    trigger: afterPrevious
    durationMs: 300
  - elementId: quote-text
    effect: fade-in
    trigger: withPrevious
    durationMs: 350
  - elementId: takeaway-rule
    effect: wipe-in
    trigger: afterPrevious
    direction: right
    durationMs: 300
  - elementId: takeaway-text
    effect: fade-in
    trigger: withPrevious
    durationMs: 300
  - elementId: footer-rule
    effect: fade-in
    trigger: afterPrevious
    durationMs: 200
  - elementId: footer-left
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
  - elementId: footer-right
    effect: fade-in
    trigger: withPrevious
    durationMs: 250
