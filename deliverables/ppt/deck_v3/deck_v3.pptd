version: v2
title: GOAI 港美股期权智能终端 — 初赛方案 v4
size: [960, 540]
theme:
  colors:
    paper: "#FCFCF9"
    panel: "#FFFFFF"
    ink: "#161A20"
    sub: "#566070"
    faint: "#98A1AD"
    hairline: "#161A2024"
    primary: "#1D4ED8"
    primaryA: "#E8EEFA"
    up: "#0E7C4A"
    down: "#D4262C"
    warn: "#B45309"
  textStyles:
    kicker:
      fontFamily: {latin: Arial, ea: Microsoft YaHei}
      fontSize: 10
      bold: true
      color: "$primary"
      letterSpacing: 2.5
    display:
      fontFamily: {latin: Georgia, ea: SimSun}
      fontSize: 28
      bold: true
      color: "$ink"
      lineHeight: 1.15
    standfirst:
      fontFamily: {latin: Arial, ea: Microsoft YaHei}
      fontSize: 12
      color: "$sub"
      lineHeight: 1.35
    body:
      fontFamily: {latin: Arial, ea: Microsoft YaHei}
      fontSize: 11.5
      color: "$ink"
      lineHeight: 1.45
    small:
      fontFamily: {latin: Arial, ea: Microsoft YaHei}
      fontSize: 10.5
      color: "$ink"
      lineHeight: 1.35
    cap:
      fontFamily: {latin: Arial, ea: Microsoft YaHei}
      fontSize: 9.5
      color: "$faint"
      lineHeight: 1.25
    source:
      fontFamily: {latin: Arial, ea: Microsoft YaHei}
      fontSize: 9
      color: "$faint"
      lineHeight: 1.2
    quote:
      fontFamily: {latin: Georgia, ea: SimSun}
      fontSize: 15
      bold: true
      color: "$ink"
      lineHeight: 1.35
    hero:
      fontFamily: Georgia
      fontSize: 44
      bold: true
      color: "$ink"
    mono:
      fontFamily: {latin: Consolas, ea: Microsoft YaHei}
      fontSize: 9.5
      color: "$sub"
      lineHeight: 1.3
    folio:
      fontFamily: Georgia
      fontSize: 10
      color: "$faint"
  tableStyles:
    default:
      cellStyle:
        fontFamily: {latin: Arial, ea: Microsoft YaHei}
        fontSize: 10.5
        color: "$ink"
        lineHeight: 1.3
        border: [null, null, {style: solid, width: 1, color: "$hairline"}, null]
        align: [left, middle]
      firstRowStyle:
        bold: true
        color: "$ink"
        border: [{style: solid, width: 1.5, color: "$ink"}, null, {style: solid, width: 1, color: "$ink"}, null]
pages:
  - pages/01_cover.page
  - pages/02_summary.page
  - pages/03_problem.page
  - pages/04_solution.page
  - pages/05_product.page
  - pages/06_hero.page
  - pages/07_evidence_pnl.page
  - pages/08_evidence_backtest.page
  - pages/09_why_agent.page
  - pages/10_architecture.page
  - pages/11_trust.page
  - pages/12_competition.page
  - pages/13_market.page
  - pages/14_team.page
  - pages/15_compliance.page
  - pages/16_roadmap.page
