pageType: cover
notes: |
  封面一句话立住产品：把观点变成一张可核验的决策卡。
  右侧四个关键数字对应能力边界，底部金句点出「可核验」的产品立场。
background:
  type: solid
  color: "$bg"
elements:
  - elementId: topbar
    elementType: shape
    bounds: [0, 0, 220, 3]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: glow
    elementType: shape
    bounds: [430, 20, 620, 460]
    shapeName: ellipse
    fill:
      type: gradient
      gradientType: radial
      stops:
        - {position: 0, color: "#38BDF82E"}
        - {position: 1, color: "#38BDF800"}
  - elementId: eyebrow
    elementType: text
    bounds: [60, 64, 640, 18]
    content:
      style: "$eyebrow"
      text: GOAI · BOUNDLESS AGENTS · FINANCE
  - elementId: title
    elementType: text
    bounds: [60, 94, 640, 150]
    content:
      style: "$title"
      fontSize: 46
      lineHeight: 1.05
      text: |
        <p><span style="color:$primary;">GOAI</span> 港美股期权智能终端</p>
        <p style="margin-top:12px; font-size:22px; color:$sub;">把观点变成一张可核验的决策卡</p>
  - elementId: tagline-tick
    elementType: shape
    bounds: [60, 258, 14, 3]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: kpoints-head
    elementType: text
    bounds: [60, 268, 400, 18]
    content:
      style: "$sub"
      bold: true
      text: 四个关键设计
  - elementId: chip1
    elementType: shape
    bounds: [60, 296, 30, 30]
    shapeName: rect
    fill: {type: solid, color: "$primaryA"}
    border: {style: solid, width: 1, color: "$hairline"}
  - elementId: chip1-num
    elementType: text
    bounds: [60, 302, 30, 18]
    content:
      fontFamily: Georgia
      fontSize: 13
      bold: true
      color: "$primary"
      align: [center, middle]
      text: "01"
  - elementId: kp1
    elementType: text
    bounds: [102, 294, 540, 34]
    content:
      style: "$small"
      text: |
        <p><strong>金融数字不由 LLM 产出</strong></p>
        <p><span style="font-size:9px; color:$sub;">行情、定价、成本、门控逐项可复算</span></p>
  - elementId: chip2
